# ==============================================================================
# n8n Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your custom/secure configurations:
#   $ cp .env.example .env
# ==============================================================================

# Timezone for the container and n8n workflows (e.g. America/Bogota, Europe/Madrid, UTC)
GENERIC_TIMEZONE=UTC

# ==============================================================================
# n8n Service Configuration
# ==============================================================================
# The port on the host machine that will map to n8n's web UI (default: 5678)
N8N_PORT=5678

# The host name or domain where n8n will be accessible. Update this if using a reverse proxy.
# N8N_HOST=localhost
# WEBHOOK_URL=https://n8n.yourdomain.com/

# CRITICAL: Encryption key used to encrypt workflow credentials in the database.
# Change this to a secure random string (minimum 24 characters).
# You can generate a random string using: openssl rand -hex 24
N8N_ENCRYPTION_KEY=generate_a_secure_random_key_here_otherwise_your_secrets_are_unsafe

# Node environment mode (production or development)
NODE_ENV=production

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
# Connection details matching the PostgreSQL service defined in docker-compose.yml
N8N_DB_TYPE=postgresdb
N8N_DB_POSTGRESDB_HOST=postgres
N8N_DB_POSTGRESDB_PORT=5432
N8N_DB_POSTGRESDB_DATABASE=n8n_db
N8N_DB_POSTGRESDB_USER=n8n_admin
# CRITICAL: Change this to a strong password
N8N_DB_POSTGRESDB_PASSWORD=change_me_to_a_secure_password_12345

# PostgreSQL container initialization environment variables (Must match the above connection credentials)
POSTGRES_USER=n8n_admin
POSTGRES_PASSWORD=change_me_to_a_secure_password_12345
POSTGRES_DB=n8n_db

# ==============================================================================
# Database Pruning Configuration (Best Practice)
# ==============================================================================
# n8n stores execution logs of every workflow. To prevent your database from filling
# up indefinitely, enable automatic pruning.
EXECUTIONS_DATA_PRUNE=true
# How many hours to keep execution data (e.g., 168 hours = 7 days)
EXECUTIONS_DATA_MAX_AGE=168
# Timeout in seconds for the pruning process (default: 3600 = 1 hour)
EXECUTIONS_DATA_PRUNE_TIMEOUT=3600
